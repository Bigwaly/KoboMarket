# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/kobomarket

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=kobomarket
PG_USER=postgres
PG_PASSWORD=change_me

# JWT Authentication
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Paystack Test Mode
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Marketplace Settings
PLATFORM_COMMISSION_RATE=5
ESCROW_TIMEOUT_HOURS=72
PAYOUT_MINIMUM_KOBO=100000

# CORS
CORS_ORIGIN=http://localhost:3000
